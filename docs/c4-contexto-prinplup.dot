digraph C4ContextoV2 {
  graph [rankdir=TB, fontname="Helvetica", bgcolor="white", pad=0.5, nodesep=0.9, ranksep=1.5,
         label=<<B>AquaPort v2 (Prinplup) — Diagrama de Contexto C4 (Nivel 1)</B>>, labelloc=t, fontsize=20];
  node [fontname="Helvetica", fontcolor="white", shape=box, style="rounded,filled", width=2.5, height=1.25];
  edge [fontname="Helvetica", fontsize=10.5, color="#475569", fontcolor="#1e293b", arrowsize=0.85];

  Solicitante [fillcolor="#08427b", color="#052e56", label=<<FONT POINT-SIZE="14"><B>Solicitante</B></FONT><BR/><FONT POINT-SIZE="10">[Persona]</FONT><BR/><BR/><FONT POINT-SIZE="10.5">Investigador o laboratorio que<BR/>pide transportar una muestra</FONT>>];
  Operador [fillcolor="#08427b", color="#052e56", label=<<FONT POINT-SIZE="14"><B>Operador Hídrico</B></FONT><BR/><FONT POINT-SIZE="10">[Persona]</FONT><BR/><BR/><FONT POINT-SIZE="10.5">Registra solicitudes y<BR/>supervisa la asignación automática</FONT>>];
  Admin [fillcolor="#08427b", color="#052e56", label=<<FONT POINT-SIZE="14"><B>Administrador ECI</B></FONT><BR/><FONT POINT-SIZE="10">[Persona]</FONT><BR/><BR/><FONT POINT-SIZE="10.5">Gestiona la flota de 15 drones<BR/>y consulta reportes</FONT>>];
  Tecnico [fillcolor="#08427b", color="#052e56", label=<<FONT POINT-SIZE="14"><B>Técnico de Mantenimiento</B></FONT><BR/><FONT POINT-SIZE="10">[Persona · NUEVO en v2]</FONT><BR/><BR/><FONT POINT-SIZE="10.5">Revisa drones en fallo<BR/>y los devuelve a servicio</FONT>>];

  AquaPort [fillcolor="#1168bd", color="#0b4884", width=4.4, height=1.6, label=<<FONT POINT-SIZE="18"><B>AquaPort v2</B></FONT><BR/><FONT POINT-SIZE="10">[Sistema de software]</FONT><BR/><BR/><FONT POINT-SIZE="11.5">Asigna automáticamente 15 drones de 3 tipos<BR/>según zona, carga y condiciones del agua,<BR/>y emite alertas cuando hay fallos</FONT>>];

  Api [fillcolor="#8a96a3", color="#6b7682", label=<<FONT POINT-SIZE="14"><B>API Condiciones Hídricas</B></FONT><BR/><FONT POINT-SIZE="10">[Sistema externo · NUEVO]</FONT><BR/><BR/><FONT POINT-SIZE="10.5">Mide agitación, profundidad<BR/>y temperatura del agua</FONT>>];
  Centro [fillcolor="#8a96a3", color="#6b7682", label=<<FONT POINT-SIZE="14"><B>Centro de Control ECI</B></FONT><BR/><FONT POINT-SIZE="10">[Sistema externo · NUEVO]</FONT><BR/><BR/><FONT POINT-SIZE="10.5">Registra misiones y autoriza<BR/>rutas acuáticas</FONT>>];
  Alertas [fillcolor="#8a96a3", color="#6b7682", label=<<FONT POINT-SIZE="14"><B>Sistema de Alertas</B></FONT><BR/><FONT POINT-SIZE="10">[Sistema externo · NUEVO]</FONT><BR/><BR/><FONT POINT-SIZE="10.5">Distribuye notificaciones<BR/>de drones en FALLO</FONT>>];

  {rank=same; Solicitante; Operador; Admin; Tecnico}
  {rank=same; Api; Centro; Alertas}

  Solicitante -> AquaPort [label=" Solicitud de transporte\n (zona destino, carga, prioridad) "];
  AquaPort -> Solicitante [label=" Código de misión y\n drone asignado ", constraint=false];
  Operador -> AquaPort [label=" Solicitudes y\n estrategia activa "];
  AquaPort -> Operador [label=" Misión asignada y\n estado de la flota ", constraint=false];
  Admin -> AquaPort [label=" Registro de drones\n (tipo, zona) "];
  AquaPort -> Admin [label=" Reportes de misiones\n y de la flota ", constraint=false];
  Tecnico -> AquaPort [label=" Cambio de estado del drone\n (FALLO → DISPONIBLE) "];
  AquaPort -> Tecnico [label=" Orden de revisión\n del drone en fallo ", constraint=false];

  AquaPort -> Api [label=" Consulta de condiciones\n de la zona destino "];
  Api -> AquaPort [label=" Agitación, profundidad\n y temperatura ", constraint=false];
  AquaPort -> Centro [label=" Registro de misión y\n alerta de misión crítica "];
  Centro -> AquaPort [label=" Autorización de\n ruta acuática ", constraint=false];
  AquaPort -> Alertas [label=" Notificación de drone\n en FALLO "];
}
